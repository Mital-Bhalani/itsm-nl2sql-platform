# Copy this file to `.env` and fill in your key:  cp .env.example .env
#
# The RUNNING app (the NL2SQL agent) calls the OpenAI API at runtime to generate SQL.
# This is different from the BUILD tool (Claude Code), which you use to build the platform.
#
# Never commit your real .env — it is gitignored. Only this example file is committed.
OPENAI_API_KEY=

# Optional: which OpenAI model the spike uses (default gpt-4o-mini).
# OPENAI_MODEL=gpt-4o-mini

# --- Model providers (multi-model) -------------------------------------------
# Which provider the agent uses by default: openai or anthropic.
# LLM_PROVIDER=openai
# Model for the default provider (otherwise OPENAI_MODEL / ANTHROPIC_MODEL or the built-in default).
# LLM_MODEL=
# Provider to try automatically when the default one fails (optional).
# LLM_FALLBACK_PROVIDER=anthropic
# Anthropic (Claude) key, needed only to use Claude as a provider.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# Extra models the API may be asked for (the defaults above are always allowed). Comma-separated,
# each "model" or "provider:model", e.g. gpt-4o,anthropic:claude-sonnet-5-5
# LLM_ALLOWED_MODELS=

# --- API and UI --------------------------------------------------------------
# When set, every /api/* call must send this value in the X-API-Key header (the UI does).
# Leave empty only for local development; run_app.py refuses a network --host without it.
# APP_API_KEY=
# Requests per client IP per minute on /api/ask, /api/sql, /api/evals, /api/feedback (default 30).
# RATE_LIMIT_PER_MIN=30
# Where the UI finds the API (run_app.py sets it for you).
# API_URL=http://127.0.0.1:8000
